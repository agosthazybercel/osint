# Optional: enables AI Deep Reports
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-nano

# Optional: better/faster web search providers. DuckDuckGo fallback works without keys.
BRAVE_SEARCH_API_KEY=
SERPAPI_KEY=

# Keep this true unless you deliberately want to remove the local confirmation gate.
REQUIRE_LAWFUL_USE=true

# Runtime tuning
DEFAULT_MAX_RESULTS_PER_QUERY=12
DEFAULT_MAX_PAGES=60
DEFAULT_DELAY_SECONDS=0.65
REQUEST_TIMEOUT_SECONDS=18
ENABLE_HTTP_CACHE=true
MAX_TEXT_CHARS_PER_PAGE=14000
